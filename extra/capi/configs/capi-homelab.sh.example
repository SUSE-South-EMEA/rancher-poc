#!/bin/bash
## ============================================================================
## capi-homelab.sh.example — Example homelab-specific values
## Copy to capi-homelab.sh and adjust. This file is gitignored.
## ============================================================================

# Cluster
CAPI_CLUSTER_NAME="downstream-rke2"
CAPI_NAMESPACE="capi-downstream"
CAPI_K8S_VERSION="v1.31.6+rke2r1"

# Control Plane
CAPI_CP_REPLICAS=1
CAPI_CP_CPU=2
CAPI_CP_MEMORY="4Gi"
CAPI_CP_DISK="40Gi"

# Workers
CAPI_WORKER_REPLICAS=1
CAPI_WORKER_CPU=1
CAPI_WORKER_MEMORY="4Gi"
CAPI_WORKER_DISK="40Gi"

# Network
CAPI_VM_ADDRESS="172.16.3.40/16"
CAPI_GATEWAY="172.16.0.1"
CAPI_DNS_SERVERS="172.16.3.6"
CAPI_DNS_SEARCH="home.lo"

# Rancher Manager
RANCHER_HOST="172.16.3.20"
RANCHER_SSH_USER="rancher"
