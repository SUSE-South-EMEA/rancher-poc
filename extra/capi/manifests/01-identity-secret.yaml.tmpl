# Template: Harvester identity secret
# The kubeconfig value must be base64-encoded Harvester kubeconfig.
# Generate with:
#   cat harvester-kubeconfig.yaml | base64 -w0
#
# DO NOT commit the actual kubeconfig to Git.
apiVersion: v1
kind: Secret
metadata:
  name: ${CAPI_IDENTITY_SECRET}
  namespace: ${CAPI_NAMESPACE}
type: Opaque
data:
  kubeconfig: ${HV_KUBECONFIG_B64}
